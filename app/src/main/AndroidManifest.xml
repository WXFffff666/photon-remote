<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 定位功能（Todo 49：使用定位自动匹配所在省市；FINE 优先，COARSE 网络兜底） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ConsumerIrManager 无需权限；此查询声明用于 Play 过滤（可选） -->
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />
    <!-- USB 红外外设路径（核心发射路径之一，见 D8/Todo 11） -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".PhotonApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotonRemote">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
